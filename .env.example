# Shopify -- no longer used anywhere in the codebase (full Shopify
# independence, 1 Sep 2026: catalog reads from Supabase, cart/checkout is
# Razorpay + Supabase orders). Kept here only because
# scripts/migrate-shopify-to-supabase.ts, a one-time migration script that
# already ran, still references the names. Safe to leave unset.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Supabase (Label AshB project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay -- test mode keys first, live keys only after the DNS cutover
# and a successful live test order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay webhook secret -- set only once the webhook is configured in the
# Razorpay dashboard (see src/app/api/webhooks/razorpay/route.ts for setup
# steps). Leaving this unset is fine before then; the route no-ops.
RAZORPAY_WEBHOOK_SECRET=

# Order alerts (all optional, sent on the first paid transition only).
# Recipients default to sales@ and binita@abenterprisesgroup.com and
# +919810725683 if these are not set.
ORDER_ALERT_EMAILS=sales@abenterprisesgroup.com,binita@abenterprisesgroup.com
ORDER_ALERT_SMS_TO=+919810725683

# Email, option 1: Resend (verify the sending domain in Resend first)
RESEND_API_KEY=
EMAIL_FROM=Label AshB Orders <orders@labelashb.in>
# Email, option 2: SMTP, for example the Hostinger mailbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SMS: Twilio. India carriers may block unregistered senders (DLT).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp group via Wassenger (off until both are set)
WASSENGER_TOKEN=
WASSENGER_GROUP_ID=

# Admin orders page at /admin/orders
ADMIN_PASSWORD=

# --- Meta Pixel + Conversions API (all optional; pixel stays inert without them) ---
# Pixel ID from Meta Events Manager (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
# System-user access token from Events Manager -> Conversions API
META_CAPI_ACCESS_TOKEN=
# Optional TEST1234-style code from Events Manager -> Test Events (remove for live)
META_TEST_EVENT_CODE=

# Google Ads purchase tracking. NEXT_PUBLIC_GOOGLE_TAG_ID is the AW-… tag
# id, NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL is the purchase conversion
# label (both from Google Ads > Goals > Conversions, once that action is
# created -- e.g. send_to "AW-123456789/AbC-D_efGh"). All-or-nothing: with
# either one unset the tag never loads and the success-page purchase event
# never fires -- safe to deploy before they exist. They are inlined at
# build time, so changing them on Vercel requires a redeploy to take
# effect in both directions.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
